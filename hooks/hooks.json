{
  "description": "Automatic background Codex review: a devil's-advocate plan review on ExitPlanMode and a bug-finding code review on Stop, both dispatched as detached jobs that never block the session. A UserPromptSubmit hook injects finished verdicts back into the session context, and a SessionEnd hook cleans up the plugin's own workers and transient files.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/auto-plan-review-hook.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/auto-code-review-hook.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/surface-verdict-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-end-cleanup-hook.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
