{
  "description": "Automatic background Codex review: a devil's-advocate plan review on ExitPlanMode and a bug-finding code review on Stop. Both dispatch detached jobs and never block the session.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/auto-plan-review-hook.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/auto-code-review-hook.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
